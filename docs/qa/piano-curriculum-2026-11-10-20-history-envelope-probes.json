          "line": 799,
          "excerpt": "      if(lesson?.contentKind!=='exercise'||!review||Object.keys(review).length!==3||review.id!=='early-legato-v1'||review.sourceFingerprint!==rule.original||review.reviewedFingerprint!==rule.fingerprint||instructionFingerprint(lesson)!==rule.fingerprint||Assessment.pianoSignature(lesson)!==rule.grade||Assessment.signature(lesson.steps)!==rule.steps)continue;"
        },
        {
          "line": 244,
          "excerpt": "    const previousInstruction=JSON.parse(JSON.stringify({guide:lesson.guide,learning}));"
        },
        {
          "line": 254,
          "excerpt": "    learning.contentReview={id:'f-major-upper-readiness-v1',sourceFingerprint:'0660dc2d',previousAssessmentFingerprint:'a78402d1',previousInstruction,reviewedFingerprint:instructionFingerprint(lesson)};"
        },
        {
          "line": 828,
          "excerpt": "      lesson.learning.contentReview={id:'early-release-v2',sourceFingerprint:rule.fingerprint,reviewedFingerprint:instructionFingerprint(lesson),previous:JSON.parse(JSON.stringify(previous))};changed++;"
        }
      ]
    },
