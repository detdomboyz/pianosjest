          "line": 9,
          "excerpt": "  function mark(l,sourceFingerprint,fingerprint){l.lessonReview={version:VERSION,scope:'instruction-and-data-review; not a teacher performance certificate',sourceFingerprint,reviewedFingerprint:fingerprint(l)};}"
        },
        {
          "line": 8,
          "excerpt": "  function allowed(l,b,fingerprint){const entry=b?.[l.id];if(!entry)return false;const now=fingerprint(l);return now===entry.fingerprint&&!(l.lessonReview?.version===VERSION&&l.lessonReview.reviewedFingerprint===now);}"
        }
      ]
    },
